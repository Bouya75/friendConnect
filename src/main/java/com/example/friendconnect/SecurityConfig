
@Bean
public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
    http
        .authorizeHttpRequests(auth -> auth
            // 1. On autorise TOUT LE MONDE à voir les fichiers statiques (Design, images, logos)
            .requestMatchers("/css/**", "/js/**", "/images/**", "/webjars/**").permitAll()

            // 2. On autorise TOUT LE MONDE à accéder aux pages d'inscription et de login
            .requestMatchers("/inscription", "/login", "/register").permitAll()

            // 3. Tout le reste de l'application requiert d'être connecté (Espace membres)
            .anyRequest().authenticated()
        )
        .formLogin(form -> form
            .loginPage("/login")
            .usernameParameter("username") // ou "email" selon ton formulaire login.html
            .defaultSuccessUrl("/accueil", true) // La page où l'utilisateur arrive après connexion
            .permitAll()
        )
        .logout(logout -> logout
            .logoutSuccessUrl("/login?logout")
            .permitAll()
        );

    return http.build();
}